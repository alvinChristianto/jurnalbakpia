#!/bin/sh
# Block direct commits on the main branch. Work on a feature branch and
# merge via PR instead.
branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ]; then
    echo "✗ Direct commits to 'main' are not allowed." >&2
    echo "  Create a branch first: git checkout -b feat/<name>" >&2
    echo "  (To bypass in emergencies: git commit --no-verify)" >&2
    exit 1
fi
